{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clousight Bench ResultRecord 0.4",
  "type": "object",
  "required": ["schema_version", "run", "identity", "environment",
    "fingerprints", "measurements", "findings", "observations", "series",
    "artifacts", "extensions", "errors", "status"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "status": {"enum": ["completed", "failed", "invalid", "unsupported", "interrupted"]},
    "run": {"type": "object"},
    "identity": {"type": "object"},
    "environment": {"type": "object"},
    "fingerprints": {"type": "object"},
    "provenance": {
      "type": "object",
      "properties": {
        "suite_id": {"type": "string"},
        "suite_version": {"type": "string"},
        "dataset_digest": {"type": "string"},
        "unmodified": {"type": "boolean"},
        "evaluator_id": {"type": "string"},
        "evaluator_official": {"type": "boolean"},
        "scaffold": {"type": "string"},
        "division": {"type": "string"}
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit"],
        "properties": {
          "value": {},
          "unit": {"type": "string"},
          "reproducibility_class": {"type": "string"},
          "official": {"type": "boolean"},
          "aggregation": {"type": "string"},
          "sample_count": {"type": ["integer", "null"]},
          "notes": {"type": "string"},
          "ci": {
            "type": ["array", "null"],
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "scores"],
        "properties": {
          "item_id": {"type": "string"},
          "group": {"type": "string"},
          "input": {},
          "output": {},
          "reference": {},
          "usage": {"type": "object"},
          "attrs": {"type": "object"},
          "scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metric", "value", "status"],
              "properties": {
                "metric": {"type": "string"},
                "value": {},
                "status": {"enum": ["ok", "fail", "skip", "error"]},
                "reason": {"type": "string"},
                "error": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {"type": "array"},
    "observations": {"type": "object"},
    "series": {"type": ["object", "array"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "media", "sha256"],
        "properties": {
          "kind": {"type": "string"},
          "media": {"type": "string"},
          "sha256": {"type": "string"},
          "path": {"type": "string"},
          "uri": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "extensions": {"type": "object"},
    "errors": {"type": "array"}
  }
}

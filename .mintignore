# Only docs/*.mdx (the pages listed in docs.json) form the Mintlify site.
# Everything below is repo prose or internal design docs that is NOT valid MDX;
# exclude it so `mint broken-links` and the Mintlify build never try to parse it.
# .mintignore uses .gitignore-style patterns.

# Repo-root prose (README, SECURITY, CONTRIBUTING, CHANGELOG, ...)
/*.md

# Non-published markdown under docs/ (internal design docs + research notes)
/docs/*.md
/docs/specs/
/docs/plans/
/docs/runbooks/
/docs/superpowers/

# Source trees that carry their own READMEs / markdown
/.github/
/src/
/tests/
/examples/
/workloads/
/results/
/infra/
/configs/
/site/
/scripts/

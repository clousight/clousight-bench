# Copy to agent-runtime-aliyun.local.yaml and fill from terraform outputs.
# The real .local.yaml is gitignored — NEVER commit real tokens/keys.
"params": {}
"target":
  "auth_env":
    "access_key_id": "ALIBABA_CLOUD_ACCESS_KEY_ID"
    "access_key_secret": "ALIBABA_CLOUD_ACCESS_KEY_SECRET"
  "mock_base_url": "https://<mock-fc-endpoint>.cn-hangzhou.fcapp.run"
  "mock_token": "<from terraform output: mock_token>"
  "mode": "real"
  "oss_bucket": "<from terraform output: oss_bucket>"
  "provider": "aliyun"
  "region": "cn-hangzhou"
  "arms_license_key": "<from ARMS console / terraform: arms_license_key>"

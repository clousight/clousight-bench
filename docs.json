{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Clousight Bench",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "favicon": "/images/favicon.png",
  "colors": {
    "primary": "#2f6df6",
    "light": "#5a8bf8",
    "dark": "#1e4fd6"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "header"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "docs/index",
              "docs/architecture"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "docs/plugins",
              "docs/probe-carrier",
              "docs/swe-bench-live-runbook",
              "docs/viewer",
              "docs/querying",
              "docs/dataset-tiers"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "docs/reference",
              "docs/RELEASING"
            ]
          }
        ]
      },
      {
        "language": "zh",
        "groups": [
          {
            "group": "快速开始",
            "pages": [
              "docs/zh/index",
              "docs/zh/architecture"
            ]
          },
          {
            "group": "指南",
            "pages": [
              "docs/zh/plugins",
              "docs/zh/probe-carrier",
              "docs/zh/swe-bench-live-runbook",
              "docs/zh/viewer",
              "docs/zh/querying",
              "docs/zh/dataset-tiers"
            ]
          },
          {
            "group": "参考",
            "pages": [
              "docs/zh/reference",
              "docs/zh/RELEASING"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "DeepWiki",
        "href": "https://deepwiki.com/clousight/clousight-bench"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/clousight/clousight-bench"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/clousight/clousight-bench"
    }
  }
}
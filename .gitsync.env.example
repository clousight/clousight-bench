# Template for scripts/gitsync.sh. Copy to `.gitsync.env` (which is gitignored):
#     cp .gitsync.env.example .gitsync.env
# The script reads $CSBENCH_REPO from the environment, or sources this file's
# copy, to know which GitHub repo to push/PR against. Auth uses your machine's
# `gh` config; no token is stored here.
CSBENCH_REPO=clousight/clousight-bench

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Clousight Bench",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "favicon": "/images/favicon.png",
  "colors": {
    "primary": "#2f6df6",
    "light": "#5a8bf8",
    "dark": "#1e4fd6"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"],
    "display": "header"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "architecture"]
          },
          {
            "group": "Guides",
            "pages": [
              "plugins",
              "probe-carrier",
              "querying",
              "reporting",
              "dataset-tiers"
            ]
          },
          {
            "group": "Reference",
            "pages": ["reference", "RELEASING"]
          }
        ]
      },
      {
        "language": "zh",
        "groups": [
          {
            "group": "快速开始",
            "pages": ["zh/index", "zh/architecture"]
          },
          {
            "group": "指南",
            "pages": [
              "zh/plugins",
              "zh/probe-carrier",
              "zh/querying",
              "zh/reporting",
              "zh/dataset-tiers"
            ]
          },
          {
            "group": "参考",
            "pages": ["zh/reference", "zh/RELEASING"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      { "label": "DeepWiki", "href": "https://deepwiki.com/clousight/clousight-bench" }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/clousight/clousight-bench"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/clousight/clousight-bench"
    }
  }
}

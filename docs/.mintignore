# docs.json lives here, so docs/ is the Mintlify content root. Exclude the
# internal, non-published docs (design specs, plans, runbooks, research notes)
# that are not valid MDX. Published pages are *.mdx (en) + zh/*.mdx; images/
# holds the logo + favicon.
# .mintignore uses .gitignore-style patterns (relative to this directory).
/specs/
/plans/
/runbooks/
/superpowers/
/*.md
